rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 每個人只能讀寫自己的資料
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /cats/{catId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
